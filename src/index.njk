---
layout: base.njk
title: Events Planning & Decor
permalink: /
eleventyComputed:
  seo_title: "{{ home.seo_title | safe }}"
  meta_description: "{{ home.meta_description | safe }}"
---
{% from "macros.njk" import photo, thumb %}

{# 1. THE INVITATION. The <h1> is real text inside the card. With no JavaScript, or with
   reduced motion, the envelope is skipped and the card is simply shown. #}
<section class="invite" data-invite aria-label="Welcome">
  <div class="invite-track">
    <div class="invite-stage">
      <a class="invite-skip" href="#services">Skip the intro</a>
      <div class="env">
        <div class="env-inner">
          <div class="env-back"></div>
          <div class="env-card">
            <h1>
              <span class="env-eyebrow">{{ home.invitation.eyebrow }}</span>
              <span class="env-title">{{ home.invitation.title }} <em>{{ home.invitation.title_accent }}</em></span>
            </h1>
            <p class="env-lead">{{ home.invitation.lead }}</p>
            <div class="note env-note">{{ home.invitation.note }}</div>
            <div class="env-actions">
              <a class="btn btn-primary" href="#services">{{ home.invitation.open_label }}</a>
              <a class="env-link" href="#enquire">{{ navigation.enquire_label }}</a>
            </div>
          </div>
          <svg class="env-shade env-shade-pocket" viewBox="0 0 560 440" aria-hidden="true" focusable="false"><path d="M0 0L257.6 193.6Q280 215.6 302.4 193.6L560 0V440H0Z"/></svg>
          <div class="env-front"></div>
          <svg class="env-shade env-shade-flap" viewBox="0 0 560 440" aria-hidden="true" focusable="false"><path d="M0 0H560L299.6 209Q280 267 260.4 209Z"/></svg>
          <div class="env-flap"><div class="env-flap-out"></div><div class="env-flap-in"></div></div>
          <button class="env-seal" type="button" aria-label="Open the invitation">A.</button>
        </div>
        <div class="env-hint" aria-hidden="true">
          <svg class="env-arrow" viewBox="0 0 24 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3V36M3 27L12 37L21 27"/></svg>
        </div>
      </div>
    </div>
  </div>
</section>

{# 2. Hero photograph, with a way in #}
<section class="band band-hero" aria-label="Photograph">
  {{ photo(home.hero, true, "Hero photo") }}
  <div class="band-fade"></div>
  <div class="band-foot">
    <p class="note">{{ home.hero.caption }}</p>
    <a class="btn btn-primary" href="#enquire">{{ navigation.enquire_label }}</a>
  </div>
</section>

{# 3. Services: the menu, and the links to the service pages #}
<section class="section services" id="services" aria-labelledby="svcH">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{{ home.services.eyebrow }}</span>
      <h2 id="svcH">{{ home.services.heading }}</h2>
    </div>

    <div class="setting">
      {# Decorative artwork, drawn by scripts/art/table_setting.py. The menu card below rests on the plate. #}
      <img class="setting-scene" src="/img/table-setting-800.webp"
           srcset="/img/table-setting-800.webp 800w, /img/table-setting-1600.webp 1600w"
           sizes="(min-width: 861px) 760px, 100vw"
           width="800" height="710" alt="" loading="lazy" decoding="async">

    <div class="paper menu-card">
      <div class="menu-label">{{ home.services.menu_label }}</div>
      <ul class="svc-list">
        {%- for item in home.services.items %}
        <li>
          {%- if item.url %}<a class="svc" href="{{ item.url }}">{% else %}<div class="svc">{% endif %}
            {{ thumb(item) }}
            <span class="svc-text">
              <span class="svc-title">{{ item.title }}</span>
              <span class="svc-body">{{ item.body }}</span>
              {%- if item.url %}<span class="svc-more">{{ item.link_label }}</span>{% endif %}
            </span>
          {%- if item.url %}</a>{% else %}</div>{% endif %}
        </li>
        {%- endfor %}
      </ul>
      <div class="note menu-note">{{ home.services.note }}</div>
    </div>
    </div>
  </div>
</section>

{# 4. The show: two photographs, stacked on a phone #}
<section class="duo" aria-label="Photographs of the entertainment">
  {%- for p in home.show.photos %}
  <div class="band">
    {{ photo(p, false, "Entertainment photo") }}
    {%- if p.caption %}<div class="band-caption note">{{ p.caption }}</div>{% endif %}
  </div>
  {%- endfor %}
</section>

{# 5. Proof: why couples choose us #}
<section class="section proof" aria-labelledby="proofH">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{{ home.proof.eyebrow }}</span>
      <h2 id="proofH">{{ home.proof.heading }}</h2>
    </div>
    <div class="proof-grid">
      <div class="letter tilt-a">
        <span class="tape" aria-hidden="true"></span>
        <p class="letter-text note">{{ home.proof.story }}</p>
        <p class="letter-sign note">{{ home.proof.signature }}</p>
      </div>
      <div class="proof-side">
        <div class="paper review-card">
          <div class="menu-label">{{ home.proof.review_label }}</div>
          <div class="review-headline">{{ home.proof.review_headline }}</div>
          <p class="review-note">{{ home.proof.review_note }}</p>
        </div>
        <figure class="paper quote-card tilt-b">
          <blockquote>&ldquo;{{ home.proof.quote }}&rdquo;</blockquote>
          <figcaption>{{ home.proof.quote_by }}</figcaption>
        </figure>
        <div class="directories">
          <span class="directories-label">{{ home.proof.directories_label }}</span>
          {%- for d in home.proof.directories %}<span class="tag">{{ d }}</span>{% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{# 6. Poppies #}
<section class="band" aria-label="Photograph">
  {{ photo(home.poppies, false, "Poppy photo") }}
  {%- if home.poppies.caption %}<div class="band-caption band-caption-top note">{{ home.poppies.caption }}</div>{% endif %}
</section>

{# 7. How it works: a real sequence #}
<section class="section" aria-labelledby="howH">
  <div class="container">
    <div class="section-head">
      <h2 id="howH">{{ home.how.heading }}</h2>
      <p>{{ home.how.intro }}</p>
    </div>
    <ol class="steps">
      {%- for s in home.how.steps %}
      <li class="paper step {{ 'tilt-a' if loop.index is odd else 'tilt-b' }}">
        <span class="note step-num" aria-hidden="true">{{ loop.index }}</span>
        <h3>{{ s.title }}</h3>
        <p>{{ s.body }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

{# 8. Full-bleed with the line #}
<section class="band band-statement" aria-label="Photograph">
  {{ photo(home.statement, false, "Statement photo") }}
  <div class="band-dim"></div>
  <p class="statement">{{ home.statement.text }} <em>{{ home.statement.accent }}</em></p>
</section>

{# 9. Gallery: swipe on a phone, columns on desktop #}
<section class="gallery" role="region" aria-label="Photo gallery" tabindex="0">
  {%- for p in home.gallery.photos %}
  <div class="band">
    {{ photo(p, false, "Gallery photo") }}
    {%- if p.caption %}<div class="band-caption note">{{ p.caption }}</div>{% endif %}
    {%- if loop.first %}<div class="gallery-swipe note" aria-hidden="true">swipe &rarr;</div>{% endif %}
  </div>
  {%- endfor %}
</section>

{# 10. FAQ: plain questions, plain answers #}
<section class="section" aria-labelledby="faqH">
  <div class="container">
    <div class="section-head">
      <h2 id="faqH">{{ home.faq.heading }}</h2>
      <p>{{ home.faq.intro }}</p>
    </div>
    <div class="faq">
      {%- for f in home.faq.items %}
      <details class="faq-item">
        <summary><span>{{ f.question }}</span><span class="faq-plus" aria-hidden="true">+</span></summary>
        <p>{{ f.answer }}</p>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>

{# 11. Journal: the latest three posts, automatically #}
<section class="section" aria-labelledby="jH">
  <div class="container">
    <div class="journal-head">
      <h2 id="jH">{{ home.journal.heading }}</h2>
      <a class="link-more" href="/blog/">{{ home.journal.link_label }}</a>
    </div>
    <div class="jcards">
      {%- for post in collections.posts | reverse %}
      {%- if loop.index <= 3 %}
      <a class="paper jcard {{ 'tilt-a' if loop.index is odd else 'tilt-b' }}" href="{{ post.url }}">
        <span class="jcard-cat">{{ post.data.category }}</span>
        <span class="jcard-title">{{ post.data.title }}</span>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</section>

{# 12. Enquiry: the RSVP card, built for thumbs #}
<section class="section" id="enquire" aria-labelledby="enqH">
  <div class="container">
    <div class="paper rsvp tilt-a">
      <div class="rsvp-inner">
        <div class="menu-label center">{{ home.enquiry.kicker }}</div>
        <h2 id="enqH">{{ home.enquiry.heading }}</h2>
        <p class="rsvp-intro">{{ home.enquiry.intro }}</p>
        <form class="rsvp-form" name="home-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="home-enquiry">
          <p class="hp"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
          <div class="rsvp-field"><label for="fNames">Your names</label><input id="fNames" name="names" type="text" autocomplete="name" required></div>
          <div class="rsvp-field"><label for="fContact">Email or phone</label><input id="fContact" name="contact" type="text" autocomplete="email" required></div>
          <div class="rsvp-field"><label for="fType">What's the occasion?</label>
            <select id="fType" name="occasion">
              <option>Wedding</option>
              <option>Corporate event</option>
              <option>Birthday or celebration</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="rsvp-field"><label for="fDate">{{ home.enquiry.date_label }}</label><input id="fDate" name="event-date" type="date" data-min-today><span class="rsvp-hint">{{ home.enquiry.date_hint }}</span></div>
          <div class="rsvp-field"><label for="fPlace">{{ home.enquiry.place_label }}</label>
            <select id="fPlace" name="place" required data-places>
              <option value="" disabled selected>{{ home.enquiry.place_prompt }}</option>
              {%- for g in home.enquiry.place_groups %}
              <optgroup label="{{ g.label }}">
                {%- for place in g.places %}
                <option>{{ place }}</option>
                {%- endfor %}
              </optgroup>
              {%- endfor %}
            </select>
          </div>
          <div class="rsvp-field"><label for="fThing">The one thing guests must remember</label><input id="fThing" name="one-thing" type="text"></div>
          <button class="btn btn-primary rsvp-send" type="submit">{{ home.enquiry.button }}</button>
          <p class="rsvp-small">{{ home.enquiry.privacy_note }} <a href="/privacy/">Privacy</a>.
            {%- if site.whatsapp_number %} Prefer to chat? <a href="https://wa.me/{{ site.whatsapp_number }}?text={{ site.whatsapp_message | urlencode }}">Message us on WhatsApp</a>.{% endif %}</p>
        </form>
      </div>
    </div>
  </div>
</section>
