---
layout: base.njk
title: Enquire
permalink: /contact/
eleventyComputed:
  seo_title: "{{ contact_page.seo_title | safe }}"
  meta_description: "{{ contact_page.meta_description | safe }}"
---
{% from "macros.njk" import enquiry_form as enquiry_form_macro %}

{# The same enquiry form as the home page (see macros.njk), in its plain style. #}
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{{ contact_page.hero_eyebrow }}</span>
    <h1>{{ contact_page.hero_heading }}</h1>
    <p>{{ contact_page.hero_body }} {{ enquiry_form.reply_note }}</p>
  </div>
</section>

<section class="section" id="enquire">
  <div class="container">
    <div class="enquire-grid">

      {{ enquiry_form_macro(enquiry_form, site, "Contact page", contact_page.form_button, true) }}

      {# The other ways to reach us, as a note taped beside the form. #}
      <aside class="paper reach tilt-b" aria-label="{{ contact_page.aside_label }}">
        <span class="tape" aria-hidden="true"></span>
        <div class="menu-label">{{ contact_page.aside_label }}</div>
        <ul class="contact-info-list">
          <li>
            <span class="label">Email</span>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          </li>
          {%- if site.whatsapp_number %}
          <li>
            <span class="label">WhatsApp</span>
            <a href="https://wa.me/{{ site.whatsapp_number }}?text={{ site.whatsapp_message | urlencode }}">Message us</a>
          </li>
          {%- endif %}
          <li>
            <span class="label">Phone</span>
            <a href="tel:{{ site.phone_link }}">{{ site.phone }}</a>
          </li>
          <li>
            <span class="label">Instagram</span>
            <a href="{{ site.instagram }}">Follow along</a>
          </li>
        </ul>
        {%- if contact_page.aside_note %}<p class="note reach-note">{{ contact_page.aside_note }}</p>{% endif %}
      </aside>

    </div>
  </div>
</section>
