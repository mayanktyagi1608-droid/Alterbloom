---
layout: base.njk
title: Contact — Alterbloom
permalink: /contact/
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{{ contact_page.hero_eyebrow }}</span>
    <h1>{{ contact_page.hero_heading }}</h1>
    <p>{{ contact_page.hero_body }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-2" style="align-items:start;">

      <form class="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact">
        <p style="display:none;"><label>Don't fill this out: <input name="bot-field"></label></p>
        <div class="form-grid">
          <div class="form-field">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="form-field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone">
          </div>
          <div class="form-field">
            <label for="event-date">Event Date</label>
            <input type="date" id="event-date" name="event-date">
          </div>
          <div class="form-field full">
            <label for="event-type">Event Type</label>
            <select id="event-type" name="event-type">
              <option>Wedding</option>
              <option>Corporate Event</option>
              <option>Birthday / Private Celebration</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-field full">
            <label for="message">Tell us about your event</label>
            <textarea id="message" name="message" rows="5" placeholder="Venue, guest count, style, budget range..."></textarea>
          </div>
        </div>
        <div style="margin-top:24px;">
          <button type="submit" class="btn btn-primary">Send Enquiry</button>
        </div>
      </form>

      <div>
        <ul class="contact-info-list">
          <li>
            <span class="label">Email</span>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          </li>
          <li>
            <span class="label">Phone</span>
            <a href="tel:{{ site.phone_link }}">{{ site.phone }}</a>
          </li>
          <li>
            <span class="label">Studio</span>
            {{ site.address }}
          </li>
          <li>
            <span class="label">Hours</span>
            {{ site.hours }}
          </li>
          <li>
            <span class="label">Follow</span>
            <a href="{{ site.instagram }}">Instagram</a> · <a href="{{ site.pinterest }}">Pinterest</a> · <a href="{{ site.facebook }}">Facebook</a>
          </li>
        </ul>

        <div class="img-placeholder wide" style="margin-top:24px;"><span>Map / Location Placeholder</span></div>
      </div>

    </div>
  </div>
</section>
