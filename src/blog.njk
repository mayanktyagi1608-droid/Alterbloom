---
layout: base.njk
title: Journal
permalink: /blog/
eleventyComputed:
  seo_title: "{{ blog_page.seo_title | safe }}"
  meta_description: "{{ blog_page.meta_description | safe }}"
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{{ blog_page.hero_eyebrow }}</span>
    <h1>{{ blog_page.hero_heading }}</h1>
    <p>{{ blog_page.hero_body }}</p>
  </div>
</section>

{# Every post, newest first, as a paper card: the same card the home page uses, with the
   cover photo (when there is one), the excerpt and the date added. #}
<section class="section" aria-label="Posts">
  <div class="container">
    <div class="jgrid">
      {%- for post in collections.posts | reverse %}
      <a class="paper jcard {{ 'tilt-a' if loop.index is odd else 'tilt-b' }}" href="{{ post.url }}">
        {%- if post.data.cover_image %}
        <img class="jcard-cover" src="{{ post.data.cover_image }}" alt="{{ post.data.cover_image_alt }}" loading="lazy" decoding="async">
        {%- endif %}
        <span class="jcard-cat">{{ post.data.category }}</span>
        <span class="jcard-title">{{ post.data.title }}</span>
        {%- if post.data.excerpt %}<span class="jcard-excerpt">{{ post.data.excerpt }}</span>{% endif %}
        <span class="jcard-date">{{ post.date | postDate }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
