---
layout: base.njk
---
{# A journal post: the cover photo as a taped print (when there is one), then the writing
   on one sheet of paper. #}
<article>
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">{{ category }} · {{ date | postDate }}</span>
      <h1>{{ title }}</h1>
    </div>
  </header>

  <section class="section">
    <div class="container">
      {%- if cover_image %}
      <figure class="paper print tilt-b">
        <span class="tape" aria-hidden="true"></span>
        <img src="{{ cover_image }}" alt="{{ cover_image_alt }}" decoding="async" fetchpriority="high">
      </figure>
      {%- endif %}
      <div class="paper sheet prose">
        {{ content | safe }}
      </div>
      <p class="sheet-foot"><a href="/blog/" class="link-more">← Back to the journal</a></p>
    </div>
  </section>
</article>

<section class="section">
  <div class="container">
    <div class="cta-banner">
      <h2>{{ blog_page.post_cta_heading }}</h2>
      <p>{{ blog_page.post_cta_body }}</p>
      <a href="{{ navigation.enquire_url }}" class="btn btn-primary">{{ navigation.enquire_label }}</a>
    </div>
  </div>
</section>
