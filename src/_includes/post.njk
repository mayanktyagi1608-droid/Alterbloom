---
layout: base.njk
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{{ category }} · {{ date | postDate }}</span>
    <h1>{{ title }}</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    {% if cover_image %}
      <img class="img-placeholder hero" src="{{ cover_image }}" alt="{{ cover_image_alt }}" style="object-fit:cover; margin-bottom:32px;">
    {% else %}
      <div class="img-placeholder hero" style="margin-bottom:32px;"><span>Post Cover Image</span></div>
    {% endif %}

    <div style="max-width:70ch; margin:0 auto;">
      {{ content | safe }}
      <a href="/blog/" class="link-more">← Back to Blog</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-banner">
      <h2>Planning something soon?</h2>
      <p>Let's talk about your event.</p>
      <a href="/contact/" class="btn btn-primary">Get in Touch</a>
    </div>
  </div>
</section>
