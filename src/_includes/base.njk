{%- set pageTitle = seo_title or (title + " — Alterbloom") -%}
{%- set enquireUrl = "#enquire" if page.url == "/" else navigation.enquire_url -%}
{%- set pageDescription = meta_description or excerpt or site.default_description -%}
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
{% if site.url %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
<meta name="theme-color" content="#123138">

<meta property="og:site_name" content="Alterbloom">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_GB">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
{% if site.url %}<meta property="og:url" content="{{ site.url }}{{ page.url }}">{% endif %}
{% if site.url and site.og_image %}<meta property="og:image" content="{{ site.url }}{{ site.og_image }}">{% endif %}
<meta name="twitter:card" content="{% if site.url and site.og_image %}summary_large_image{% else %}summary{% endif %}">

<link rel="preload" href="/css/fonts/work-sans.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/css/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/sections.css">
<script>document.documentElement.className+=" js"</script>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", function (user) {
      if (!user) {
        window.netlifyIdentity.on("login", function () {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="container nav-row">
    <a href="/" class="logo wordmark">Alterbloom<span class="dot">.</span></a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {%- for item in navigation.main %}
        <li><a href="{{ item.url }}" {% if page.url == item.url or (item.url != "/" and item.url in page.url) %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li class="nav-cta"><a href="{{ enquireUrl }}">{{ navigation.enquire_label }}</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4 class="wordmark">Alterbloom<span class="dot">.</span></h4>
        <p>{{ site.tagline }}</p>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          {%- for item in navigation.footer %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div>
        <h4>Legal</h4>
        <ul>
          <li><a href="/privacy/" {% if page.url == "/privacy/" %}aria-current="page"{% endif %}>Privacy Policy</a></li>
          <li><a href="/terms/" {% if page.url == "/terms/" %}aria-current="page"{% endif %}>Terms &amp; Conditions</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          {%- if site.whatsapp_number %}
          <li><a href="https://wa.me/{{ site.whatsapp_number }}">WhatsApp</a></li>
          {%- endif %}
          <li><a href="tel:{{ site.phone_link }}">{{ site.phone }}</a></li>
          <li><a href="{{ site.instagram }}">Instagram</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ currentYear }} Alterbloom. All rights reserved.</span>
      <span><a href="/admin/">Site admin</a></span>
    </div>
  </div>
</footer>

<div class="thumb-bar">
  <a class="btn btn-primary" href="{{ enquireUrl }}">{{ navigation.enquire_label }}</a>
  {%- if site.whatsapp_number %}
  <a class="btn" href="https://wa.me/{{ site.whatsapp_number }}?text={{ site.whatsapp_message | urlencode }}">WhatsApp</a>
  {%- endif %}
</div>

<script src="/js/main.js"></script>
<script src="/js/invite.js" defer></script>
</body>
</html>
